---
import { GITHUB_REPOSITORY_URL, UPSTREAM_REPOSITORY_URL } from "../lib/site";
import { RELEASES_URL } from "../lib/releases";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const {
  title = "Akeru Bot",
  description = "Akeru Bot — the open-source Grok Bot alternative. Hand real work to AI teammates. Always free.",
  pageClass,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=EB+Garamond:wght@500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <div class:list={["page", pageClass]}>
      <nav class="nav">
        <a href="/" class="nav-brand" aria-label="Akeru Bot home">akeru</a>
        <div class="nav-right">
          <a class="nav-link" href="/#features">Features</a>
          <a class="nav-link" href="/#pricing">Pricing</a>
          <a class="nav-link" href={RELEASES_URL} target="_blank" rel="noopener noreferrer">Changelog</a>
          <a class="nav-link" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a class="nav-cta" href="/download">Download</a>
        </div>
      </nav>

      <main class="main">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer-divider"></div>
        <div class="footer-content">
          <div class="footer-left">
            <a href="/" class="footer-brand">akeru</a>
            <p class="footer-desc">
              An open-source Grok Bot alternative, built on a fork of T3 Code.
              Bring your own subscription and keep your own data.
            </p>
          </div>
          <div class="footer-cols">
            <div class="footer-col">
              <span class="footer-col-title">PRODUCT</span>
              <a href="/#features">Features</a>
              <a href="/#pricing">Pricing</a>
              <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">Changelog</a>
            </div>
            <div class="footer-col">
              <span class="footer-col-title">OPEN SOURCE</span>
              <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
              <a href={UPSTREAM_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">T3 Code upstream</a>
              <a href={`${GITHUB_REPOSITORY_URL}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noopener noreferrer">Contributing</a>
            </div>
            <div class="footer-col">
              <span class="footer-col-title">LEGAL</span>
              <a href="/terms-of-service">Terms</a>
              <a href="/privacy-policy">Privacy</a>
              <a href="/security-policy">Security</a>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <span>&copy; {new Date().getFullYear()} Akeru. MIT licensed.</span>
          <span class="footer-fork">
            Forked from
            <a href={UPSTREAM_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">T3 Code</a>
            with love <span class="footer-heart">♥</span>
          </span>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    /* Akeru design tokens (Paper: "Akeru Bot" file) */
    --color-background: #050505;
    --color-foreground: #f4f4f5;
    --color-card: #181818;
    --color-muted: #1b1b1b;
    --color-muted-foreground: #a1a1aa;
    --color-primary: #8b6fc9;
    --color-primary-foreground: #0a0712;
    --color-border: #2b2b2b;
    --color-destructive: #e2574a;
    --font-sans: "Geist", system-ui, sans-serif;
    --font-serif: "EB Garamond", system-ui, sans-serif;
    --radius-sm: 6px;
    --radius-md: 8px;
    --radius-lg: 12px;

    /* Legacy aliases used by the legal and download pages */
    --bg: var(--color-background);
    --fg: var(--color-foreground);
    --fg-muted: var(--color-muted-foreground);
    --fg-dim: #71717a;
    --fg-faint: #52525b;
    --border: var(--color-border);
    --border-strong: #3f3f3f;
    --accent: var(--color-primary);
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    color-scheme: dark;
    scroll-behavior: smooth;
  }

  body {
    background: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
    overflow-x: hidden;
    line-height: 1.5;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font-family: inherit;
    cursor: pointer;
    border: 0;
    background: none;
    color: inherit;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  :focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 4px;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    max-width: 1440px;
    margin: 0 auto;
    overflow-x: clip;
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* ── Nav ── */

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 26px 48px;
  }

  .nav-brand {
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 30px;
    font-weight: 500;
    color: var(--color-foreground);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-link {
    font-size: 14px;
    line-height: 18px;
    color: var(--color-muted-foreground);
    transition: color 0.18s ease;
  }

  .nav-link:hover {
    color: var(--color-foreground);
  }

  .nav-cta {
    display: flex;
    align-items: center;
    height: 34px;
    padding: 0 16px;
    border-radius: 7px;
    border: 1px solid var(--color-border);
    font-size: 13.5px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-foreground);
    transition: border-color 0.18s ease;
  }

  .nav-cta:hover {
    border-color: var(--color-primary);
  }

  /* ── Footer ── */

  .footer {
    display: flex;
    flex-direction: column;
    margin-top: 96px;
    padding: 0 48px 40px;
  }

  .footer-divider {
    height: 1px;
    width: 100%;
    background: var(--color-border);
  }

  .footer-content {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 48px;
    flex-wrap: wrap;
    padding-top: 32px;
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-brand {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 24px;
    font-weight: 500;
    color: var(--color-foreground);
  }

  .footer-desc {
    font-size: 13px;
    line-height: 20px;
    max-width: 340px;
    color: var(--color-muted-foreground);
  }

  .footer-cols {
    display: flex;
    align-items: flex-start;
    gap: 56px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col-title {
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.06em;
    font-weight: 500;
    color: var(--color-muted-foreground);
  }

  .footer-col a {
    font-size: 13.5px;
    line-height: 18px;
    color: var(--color-muted-foreground);
    transition: color 0.18s ease;
  }

  .footer-col a:hover {
    color: var(--color-foreground);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 36px;
    font-size: 12px;
    line-height: 16px;
    color: var(--color-muted-foreground);
  }

  .footer-fork a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-position: from-font;
  }

  .footer-heart {
    color: var(--color-destructive);
  }

  /* ── Mobile ── */

  @media (max-width: 720px) {
    .nav {
      padding: 20px 24px;
    }

    .nav-right {
      gap: 16px;
    }

    .nav-link {
      display: none;
    }

    .footer {
      padding: 0 24px 32px;
    }
  }
</style>
